# DeepSeek API 密钥（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 以下为可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
PORT=8083
ADMIN_TOKEN=atoms-admin-2026

